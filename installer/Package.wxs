<?xml version="1.0" encoding="utf-8"?>
<!--
  A Beautiful Potato Launcher - MSI

  Scope is perUser on purpose. A perMachine install writes to Program Files and
  therefore triggers a UAC elevation prompt, which is exactly the kind of thing
  that makes players hesitate. Per-user installs into LocalAppData, needs no
  administrator rights, and shows no UAC prompt at all.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="A Beautiful Potato Launcher"
      Manufacturer="A Beautiful Potato"
      Version="1.0.0"
      UpgradeCode="CC354B22-2910-47E9-8712-366A265A4D67"
      Scope="perUser"
      Compressed="yes">

    <SummaryInformation Description="Server browser and launcher for the A Beautiful Potato DayZ servers" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="PotatoIcon" SourceFile="..\assets\potato.ico" />
    <Property Id="ARPPRODUCTICON" Value="PotatoIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Feature Id="Main" Title="A Beautiful Potato Launcher" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>
  </Package>

  <Fragment>
    <!-- Per-user install location: %LOCALAPPDATA%\Programs\... -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="A Beautiful Potato Launcher" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="A Beautiful Potato" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppComponents">

      <Component Id="LauncherExe" Directory="INSTALLFOLDER" Guid="*">
        <File Id="LauncherExeFile"
              Source="..\bin\Release\net48\ABeautifulPotatoLauncher.exe"
              KeyPath="yes" />
      </Component>

      <!-- Shortcuts. A per-user component needs a registry keypath rather than a
           file keypath, so the installer can track it without admin rights. -->
      <Component Id="StartMenuShortcut" Directory="AppShortcutFolder" Guid="*">
        <Shortcut Id="StartMenuLink"
                  Name="A Beautiful Potato Launcher"
                  Description="Browse and join the A Beautiful Potato DayZ servers"
                  Target="[INSTALLFOLDER]ABeautifulPotatoLauncher.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\A Beautiful Potato\Experimental Launcher"
                       Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
        <Shortcut Id="DesktopLink"
                  Name="A Beautiful Potato Launcher"
                  Description="Browse and join the A Beautiful Potato DayZ servers"
                  Target="[INSTALLFOLDER]ABeautifulPotatoLauncher.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\A Beautiful Potato\Experimental Launcher"
                       Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
