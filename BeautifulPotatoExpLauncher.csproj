<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48 on purpose: .NET Framework 4.8 ships with Windows 10 and 11, so
         players install nothing. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BeautifulPotatoExpLauncher</AssemblyName>
    <RootNamespace>BeautifulPotatoExpLauncher</RootNamespace>
    <Product>A Beautiful Potato Launcher</Product>
    <AssemblyTitle>A Beautiful Potato Launcher</AssemblyTitle>
    <Company>A Beautiful Potato</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>A Beautiful Potato</Copyright>
    <DebugType>none</DebugType>
    <!-- The reference screenshots live in assets\ too; they are documentation,
         not resources, so they are kept out of the build. -->
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assets are optional for this workspace build; the runtime launcher still
         works without these local branding resources present. -->
  </ItemGroup>

</Project>
